# --- Database (Neon or Supabase Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# --- First admin account (read once by prisma/seed.ts, then only the hash is stored) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-seeding"
ADMIN_NAME="Store Admin"

# --- Cloudinary (product images) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Resend (password reset + order emails) ---
RESEND_API_KEY=""
EMAIL_FROM="Store <no-reply@yourdomain.com>"

# --- App ---
# Used to build absolute links in emails (password reset, order confirmation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
