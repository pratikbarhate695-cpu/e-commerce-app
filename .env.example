# --- Database (Neon or Supabase Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Supabase Auth ---
# Project URL and PUBLISHABLE key only (both are safe in the browser).
# NEVER put the Supabase secret / service_role key in this project,
# in Netlify, or in GitHub. See AUTH.md.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- First admin (read by prisma/seed.ts) ---
# Makes sure this email has the ADMIN role in the database.
# The admin's password is set in Supabase, not here. See AUTH.md.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Store Admin"

# --- Cloudinary (product images) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Resend (order emails) ---
RESEND_API_KEY=""
EMAIL_FROM="Store <no-reply@yourdomain.com>"

# --- App ---
# Used to build absolute links in emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"
