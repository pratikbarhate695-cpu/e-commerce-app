# Copy to .env and fill in. Never commit .env or share the secrets.
# Neon: use the POOLED connection string (host contains "-pooler") for the website.
DATABASE_URL=
# Direct (non-pooler) URL for Prisma CLI schema operations such as db push.
DIRECT_URL=
# Used by the one-time Prisma seed script to create/promote the admin DB row.
ADMIN_EMAIL=
ADMIN_NAME=Zero Integration Admin
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional legacy password-reset email helper (customer sign-in currently uses Supabase OTP).
RESEND_API_KEY=
EMAIL_FROM=Zero Integration <noreply@example.com>
